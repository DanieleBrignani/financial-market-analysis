# Figures are COMMITTED on purpose: a reviewer should see the results on
# GitHub without installing R. Only the regenerable tables are ignored.

# Cached downloads -- regenerated by the pipeline.
# The committed snapshot in data/processed/ is what makes runs reproducible.
data/raw/*.rds

# Generated tables (regenerate with: Rscript scripts/run_analysis.R)
output/tables/*.csv
output/tables/*.txt

# NOT ignored, and committed deliberately:
#   data/processed/monthly_prices.csv  -- pins the sample; required by CI
#   output/figures/*.png               -- visible on GitHub without running R

